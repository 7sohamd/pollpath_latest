{
    "version": 2,
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "framework": "vite",
    "crons": [
        {
            "path": "/api/cron/cleanup-polls",
            "schedule": "0 0 * * *"
        }
    ],
    "functions": {
        "api/**/*.js": {
            "maxDuration": 30
        }
    }
}